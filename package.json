{
  "name": "@veyforma/charts",
  "version": "1.2.0",
  "description": "Zero-dependency JavaScript charts for finance and risk: exposure heatmap, risk-factor tornado, P&L attribution, debt maturity ladder and exposure accumulation map.",
  "keywords": [
    "charts",
    "data-visualization",
    "heatmap",
    "tornado-chart",
    "sensitivity-analysis",
    "finance",
    "risk-management",
    "credit-risk",
    "market-risk",
    "frtb",
    "svg",
    "zero-dependency",
    "accessible",
    "debt-maturity",
    "treasury",
    "insurance",
    "catastrophe-risk",
    "map"
  ],
  "homepage": "https://veyforma.github.io/veyforma-charts/examples/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veyforma/veyforma-charts.git"
  },
  "bugs": "https://github.com/Veyforma/veyforma-charts/issues",
  "license": "MIT",
  "author": "Veyforma (https://www.veyforma.com)",
  "type": "module",
  "main": "./dist/veyforma-charts.cjs",
  "module": "./dist/veyforma-charts.mjs",
  "unpkg": "./dist/veyforma-charts.min.js",
  "jsdelivr": "./dist/veyforma-charts.min.js",
  "exports": {
    ".": {
      "import": "./dist/veyforma-charts.mjs",
      "require": "./dist/veyforma-charts.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
